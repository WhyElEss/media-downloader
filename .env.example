# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Host port for the web UI.
HOST_PORT=8790
# Absolute host path of the media library (mounted to /library).
LIBRARY_PATH=
# Owner of downloaded files on the host (`id -u` / `id -g`).
PUID=1000
PGID=1000
UMASK=022
TZ=UTC

# Login (mandatory). Generate the hash with:
#   docker compose run --rm mediadl hashpw
APP_USERNAME=admin
APP_PASSWORD_HASH=
# Session lifetime in days.
SESSION_DAYS=7
# Failed logins per IP before a lockout, and lockout length in minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Secure flag on the session cookie: auto (when the request is HTTPS), true, false.
COOKIE_SECURE=auto
# Proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or *).
FORWARDED_ALLOW_IPS=*

# Parallel engine processes.
MAX_CONCURRENT=2
# Upgrade yt-dlp and gallery-dl on every container start.
AUTO_UPDATE_ENGINES=true

# Container limits.
CPUS=2
MEM_LIMIT=1g
